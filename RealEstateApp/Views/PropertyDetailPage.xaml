<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RealEstateApp.Views.PropertyDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:FontAwesome"
    xmlns:conv="clr-namespace:RealEstateApp.Converters"
    xmlns:vm="clr-namespace:RealEstateApp.ViewModels"
    Title="{Binding Property.Address}"
    x:DataType="vm:PropertyDetailPageViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding EditPropertyCommand}" CommandParameter="{Binding Property}" Text="Edit" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <Grid
            Padding="15"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="10">
            <Image
                Grid.Row="0"
                Margin="-10,-10,-10,0"
                Aspect="AspectFill"
                HeightRequest="225"
                Source="{Binding Property.MainImageUrl}" />
            <Label
                Grid.Row="1"
                FontAttributes="Bold"
                FontSize="16"
                LineBreakMode="NoWrap"
                Text="{Binding Property.Price, StringFormat='{0:C0}'}" />
            <HorizontalStackLayout Grid.Row="2" Spacing="5">
                <Label
                    FontSize="16"
                    LineBreakMode="NoWrap"
                    VerticalOptions="Center"
                    Text="{Binding Property.Address}" />
                <Button Text="{Static fa:IconFont.MapPin}" FontFamily="FA-solid" Command="{Binding OpenMapCommand}" VerticalOptions="Center">
                </Button>
                <Button Text="{Static fa:IconFont.Directions}" FontFamily="FA-solid" Command="{Binding OpenMapGuideCommand}" VerticalOptions="Center">
                </Button>
            </HorizontalStackLayout>
            
            <Grid
                Grid.Row="3"
                ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="10">
                <Label
                    Grid.Column="0"
                    FontFamily="FA-solid"
                    FontSize="16"
                    Text="{Static fa:IconFont.Bed}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    FontSize="16"
                    Text="{Binding Property.Beds}" />
                <Label
                    Grid.Column="2"
                    FontFamily="FA-solid"
                    FontSize="16"
                    Text="{Static fa:IconFont.Bath}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="3"
                    FontSize="16"
                    Text="{Binding Property.Baths}" />
                <Label
                    Grid.Column="4"
                    FontFamily="FA-solid"
                    FontSize="16"
                    Text="{Static fa:IconFont.Parking}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="5"
                    FontSize="16"
                    Text="{Binding Property.Parking}" />
            </Grid>
            <Label
                Grid.Row="4"
                FontSize="14"
                Text="{Binding Property.LandSize, StringFormat='Land size: {0} &#x33a1;'}" />
            <HorizontalStackLayout Grid.Row="5">
                <Label
                    Margin="0,20,0,0"
                    FontAttributes="Bold"
                    FontSize="14"
                    Text="Description:"
                    VerticalOptions="Center"/>
                
                <Button
                    Text="{x:Static fa:IconFont.Play}"
                    FontSize="Medium"
                    FontFamily="FA-solid"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsReading, Converter={conv:InverseBoolConverter}}"
                    TextColor="Purple"
                    Command="{Binding ReadDescriptionCommand}" />
                <Button
                    Text="{x:Static fa:IconFont.Stop}"
                    FontSize="Medium"
                    FontFamily="FA-solid"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsReading}"
                    TextColor="Purple"
                    Command="{Binding StopReadingCommand}" />
            </HorizontalStackLayout>
            
            <Label
                Grid.Row="6"
                Margin="0,0,0,20"
                FontSize="14"
                Text="{Binding Property.Description}" />
            <VerticalStackLayout Grid.Row="7">
                <Label
                    FontAttributes="Bold"
                    FontSize="14"
                    Text="Vendor:" />
                <HorizontalStackLayout Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontFamily="FA-solid"
                        VerticalOptions="Center"
                        Text="{Static fa:IconFont.User}" />
                    <Label
                        FontAttributes="Bold"
                        Text="{Binding Property.Vendor.FullName}"
                        VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Border>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PropertyDetailPageViewModel}}, Path=OpenMailCommand}" CommandParameter="{Binding Property.Vendor.Email}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontFamily="FA-solid"
                            VerticalOptions="Center"
                            Text="{Static fa:IconFont.Envelope}" />
                        <Label
                            FontAttributes="Bold"
                            Text="{Binding Property.Vendor.Email}"
                            VerticalOptions="Center"
                            TextColor="Blue"/>
                    </HorizontalStackLayout>
                </Border>
                <Border>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PropertyDetailPageViewModel}}, Path=PhoneDialogCommand}" CommandParameter="{Binding Property.Vendor.Phone}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontFamily="FA-solid"
                            VerticalOptions="Center"
                            Text="{Static fa:IconFont.Phone}" />
                        <Label
                            FontAttributes="Bold"
                            Text="{Binding Property.Vendor.Phone}"
                            VerticalOptions="Center"
                            TextColor="Blue"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
            <Label
                Grid.Row="8"
                FontAttributes="Bold"
                FontSize="14"
                Text="Listed by:" />
            <Grid Grid.Row="8" ColumnDefinitions="auto, *">
                <Image
                    Grid.Column="0"
                    Source="{Binding Agent.ImageUrl}"
                    VerticalOptions="Start"
                    WidthRequest="100" />
                <Grid
                    Grid.Column="1"
                    Margin="10"
                    RowDefinitions="Auto,Auto,Auto">
                    <Label
                        Grid.Row="0"
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="{Binding Agent.Name}" />
                    <Label
                        Grid.Row="1"
                        FontSize="12"
                        Text="{Binding Agent.Email}" />
                    <Label
                        Grid.Row="2"
                        FontSize="12"
                        Text="{Binding Agent.Phone}" />
                </Grid>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>