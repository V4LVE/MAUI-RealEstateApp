<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RealEstateApp.Views.SettingsPage"
             Title="SettingsPage"
             xmlns:vm="clr-namespace:RealEstateApp.ViewModels"
             x:DataType="vm:SettingsPageViewModel">
    
    <VerticalStackLayout>
        <Label Text="Volume"/>
        <Slider 
            Minimum="0" 
            Maximum="1"
            Value="{Binding Volume}"/>
        <Label Text="Pitch"/>
        <Slider 
            Minimum="0.1" 
            Maximum="2"
            Value="{Binding Pitch}"/>
        <Button Text="Reset Settings" Command="{Binding ResetSettingsCommand}" />
    </VerticalStackLayout>
</ContentPage>